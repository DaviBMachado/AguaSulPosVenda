<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReclamacao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Topo do Card: Nome e Data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClienteNome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Condomínio Reserva das Águas" />

            <TextView
                android:id="@+id/tvDataAbertura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                tools:text="05/10/2026 09:15" />
        </LinearLayout>

        <!-- Badges de Origem e Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Badge de Status -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:backgroundTint="@color/alerta_reclamacao_bg"
                tools:text="ABERTA"
                tools:textColor="@color/alerta_reclamacao_text" />

            <!-- Badge de Origem -->
            <TextView
                android:id="@+id/tvOrigemBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/primary_container"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/on_primary_container"
                android:textSize="11sp"
                tools:text="Origem: Cliente" />

        </LinearLayout>

        <!-- Descrição da Queixa -->
        <TextView
            android:id="@+id/tvDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="Baixa vazão no bloco B relatada após limpeza periódica dos reservatórios." />

        <!-- Seção de Parecer de Resolução (se houver) -->
        <LinearLayout
            android:id="@+id/layoutResolucao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/status_concluida_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parecer Técnico de Resolução:"
                android:textColor="@color/status_concluida_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResolucaoTecnica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/status_concluida_text"
                android:textSize="13sp"
                tools:text="Substituição da válvula realizada e pressão restabelecida." />
        </LinearLayout>

        <!-- Rodapé indicativo de ação para técnicos -->
        <TextView
            android:id="@+id/tvAcaoHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Toque para registrar parecer e resolver ocorrência →"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
